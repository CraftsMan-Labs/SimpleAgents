# Canonical cross-language binding env contract
# Required for live tests/examples:
# PROVIDER=openai|anthropic|openrouter
# CUSTOM_API_KEY=<api-key>
# CUSTOM_API_MODEL=<model-id>
# Optional:
# CUSTOM_API_BASE=<provider-base-url>
#
# Some repo example scripts (e.g. under examples/python-test-simpleAgents/runners and
# examples/napi-test-simpleAgents/runners) read WORKFLOW_PROVIDER, WORKFLOW_API_KEY, and
# WORKFLOW_API_BASE instead. You can duplicate values from CUSTOM_* / PROVIDER there,
# or point those variables at the same provider and key.

PROVIDER=openai
CUSTOM_API_KEY=
CUSTOM_API_MODEL=
CUSTOM_API_BASE=
