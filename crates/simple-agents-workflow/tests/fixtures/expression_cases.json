[
  {
    "name": "boolean and equality",
    "expression": "input.approved && input.score == 9",
    "scoped_input": {
      "input": {
        "approved": true,
        "score": 9
      }
    },
    "expected": true
  },
  {
    "name": "negation",
    "expression": "!input.approved",
    "scoped_input": {
      "input": {
        "approved": false
      }
    },
    "expected": true
  },
  {
    "name": "missing path",
    "expression": "input.missing == 1",
    "scoped_input": {
      "input": {
        "ok": 1
      }
    },
    "expect_error": "path 'input.missing' not found in scoped input"
  }
]
